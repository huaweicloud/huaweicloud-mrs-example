<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>hetu-rest-client-example</artifactId>
    <version>8.6.0-360.r9</version>

    <properties>
        <source>1.8</source>
        <target>1.8</target>
        <hetu-jdbc.version>453-h0.cbu.mrs.360.r9</hetu-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>hetu-jdbc</artifactId>
            <version>${hetu-jdbc.version}</version>
            <exclusions>
                <exclusion>
                  <artifactId>*</artifactId>
                  <groupId>*</groupId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>build-with-jdk8</id>
            <activation>
                <jdk>[1.8,17)</jdk>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <source>1.8</source>
                <target>1.8</target>
            </properties>
        </profile>
        <profile>
            <id>build-with-jdk17</id>
            <activation>
                <jdk>[17,21)</jdk>
            </activation>
            <properties>
                <source>17</source>
                <target>17</target>
            </properties>
        </profile>
        <profile>
            <id>build-with-jdk21</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <properties>
                <source>21</source>
                <target>21</target>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${source}</source>
                    <target>${target}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
